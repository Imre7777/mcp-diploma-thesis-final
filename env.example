# MCP Educational Server - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: OpenAI API Key
# =============================================================================
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# =============================================================================
# OPTIONAL: OAuth / Scalekit (for production with authentication)
# =============================================================================
ENABLE_AUTH=false
SCALEKIT_ENV_URL=https://mcpeduauth.scalekit.dev
SCALEKIT_CLIENT_ID=your-client-id-here
SCALEKIT_CLIENT_SECRET=your-client-secret-here

# =============================================================================
# NOTE: Other settings are configured in docker-compose.yml
# =============================================================================
# These are already set in docker-compose.yml:
# - VECTOR_DB_URL=http://qdrant:6334
# - DEFAULT_COLLECTION=educational_content
# - HTTP_HOST=0.0.0.0
# - HTTP_PORT=8000
# - LOG_LEVEL=INFO
# - ENABLE_RBAC=true
# - DEFAULT_USER_ROLE=student
# - EMBEDDING_MODEL=text-embedding-3-large
