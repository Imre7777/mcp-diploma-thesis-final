# Caddy Configuration for MCP Educational Server
# Domain: leowiki-mcp.stream

{
    # Global options
    email imre@leowiki-mcp.stream
    
    # Use Let's Encrypt production
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

leowiki-mcp.stream {
    # Reverse proxy to MCP server
    reverse_proxy mcp-server:8000 {
        # Health check
        health_uri /health
        health_interval 30s
        health_timeout 10s
        
        # Headers
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    
    # Security headers
    header {
        # Enable HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        
        # Prevent MIME sniffing
        X-Content-Type-Options "nosniff"
        
        # Enable XSS protection
        X-XSS-Protection "1; mode=block"
        
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # Remove server header
        -Server
    }
    
    # Logging
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 10
        }
        format json
    }
    
    # Rate limiting (optional)
    rate_limit {
        zone mcp {
            key {remote_host}
            events 100
            window 1m
        }
    }
    
    # Enable compression
    encode gzip zstd
    
    # OAuth metadata endpoint (for MCP clients)
    handle /.well-known/oauth-protected-resource {
        reverse_proxy mcp-server:8000
    }
    
    # MCP endpoint (Server-Sent Events)
    handle /mcp* {
        reverse_proxy mcp-server:8000 {
            # Important: Disable buffering for SSE
            flush_interval -1
            
            # Longer timeout for SSE connections
            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }
    
    # API endpoints
    handle /api/* {
        reverse_proxy mcp-server:8000
    }
    
    # Health check (public)
    handle /health {
        reverse_proxy mcp-server:8000
    }
    
    # Documentation
    handle /docs* {
        reverse_proxy mcp-server:8000
    }
    
    # Root redirect to docs
    handle / {
        redir /docs permanent
    }
}

# Redirect www to non-www
www.leowiki-mcp.stream {
    redir https://leowiki-mcp.stream{uri} permanent
}
